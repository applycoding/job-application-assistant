# Job Application Assistant - copy to .env and adjust as needed

# Provider: mock (offline), anthropic, openai, google, xai
JAA_PROVIDER=mock

# Optional model overrides (defaults from providers.toml)
# JAA_MODEL=
# JAA_JUDGE_MODEL=

# JAA_JUDGE=off
JAA_JUDGE=off

JAA_DB_PATH=var/jaa.sqlite3
JAA_SAMPLES_DIR=samples
JAA_ENABLE_SAMPLES=true

JAA_HOST=127.0.0.1
JAA_PORT=8000
# Browser-facing port for Origin checks (defaults to JAA_PORT)
# JAA_PUBLIC_PORT=

# Fixed reference date for duration checks (YYYY-MM-DD); empty = today
# JAA_REFERENCE_DATE=

# Optional extra skills file merged with built-in lexicon
# JAA_SKILLS_FILE=

JAA_MAX_UPLOAD_MB=5

# Provider HTTP timeout (seconds) and whole-run deadline
# JAA_REQUEST_TIMEOUT_S=60
# JAA_RUN_DEADLINE_S=120

# Echoed by /healthz for e2e tests
# JAA_INSTANCE_NONCE=

# Real LLM keys (only needed when JAA_PROVIDER is not mock)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
